    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",

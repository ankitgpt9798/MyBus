# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mybus
# Public URL of the Angular app (used in email links)
FRONTEND_URL=http://localhost:4200
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4200

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded admin account (created/updated by `npm run seed`)
ADMIN_EMAIL=admin@mybus.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=MyBus Admin

# Email (SMTP). Leave SMTP_HOST empty to print emails/links to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyBus <no-reply@mybus.local>"

# Booking
SEAT_HOLD_MINUTES=10

# Community photo uploads (optional; default backend/uploads, git-ignored)
# UPLOADS_DIR=

# Web push (VAPID). Leave empty to generate a key pair on first start, saved to backend/.vapid-keys.json (git-ignored).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com (defaults to mailto:ADMIN_EMAIL)
VAPID_SUBJECT=

# Notification retries - for tests only; defaults are 1 min / 5 min / 15 min, checked every 30 s
# NOTIFY_RETRY_DELAYS_MS=60000,300000,900000
# NOTIFY_RETRY_INTERVAL_MS=30000
# NOTIFY_STREAM_HEARTBEAT_MS=15000
# Journey reminders - tests only; defaults send them 24 h and 2 h before departure, checked every minute
# REMINDER_LEADS_MS=86400000,7200000
# REMINDER_INTERVAL_MS=60000

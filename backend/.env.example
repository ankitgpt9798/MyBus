# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mybus
# Public URL of the Angular app (used in email links)
FRONTEND_URL=http://localhost:4200
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4200

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded admin account (created/updated by `npm run seed`)
ADMIN_EMAIL=admin@mybus.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=MyBus Admin

# Email (SMTP). Leave SMTP_HOST empty to print emails/links to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyBus <no-reply@mybus.local>"

# Booking
SEAT_HOLD_MINUTES=10

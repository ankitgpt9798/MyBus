# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mybus
# Public URL of the Angular app (used in email links)
FRONTEND_URL=http://localhost:4200
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4200

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded admin account (created/updated by `npm run seed`)
ADMIN_EMAIL=admin@mybus.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=MyBus Admin

# Email (SMTP). Leave SMTP_HOST empty to print emails/links to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyBus <no-reply@mybus.local>"

# Booking
SEAT_HOLD_MINUTES=10

# Community photo uploads kept locally (optional; default backend/uploads, git-ignored)
# UPLOADS_DIR=

# Community photos on Cloudinary. PHOTO_STORAGE=cloudinary|local; by default Cloudinary is used when the three
# credentials are set. Images go into CLOUDINARY_FOLDER (default mybus/community).
PHOTO_STORAGE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Web push (VAPID). Leave empty to generate a key pair the first time push is used, saved to backend/.vapid-keys.json (git-ignored).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com (defaults to mailto:ADMIN_EMAIL)
VAPID_SUBJECT=

# Route planner: TomTom key with Search, Routing, Traffic and Map Display enabled.
# Leave empty to plan without live traffic (MyBus places, OSRM routes, OpenStreetMap tiles).
TOMTOM_API_KEY=

# Notification retries - for tests only; defaults are 1 min / 5 min / 15 min, checked every 30 s
# NOTIFY_RETRY_DELAYS_MS=60000,300000,900000
# NOTIFY_RETRY_INTERVAL_MS=30000
# NOTIFY_STREAM_HEARTBEAT_MS=15000
# Journey reminders - tests only; defaults send them 24 h and 2 h before departure, checked every minute
# REMINDER_LEADS_MS=86400000,7200000
# REMINDER_INTERVAL_MS=60000
# Route planner - tests only: provider URLs (mock servers), upstream timeout, refresh interval of an open plan,
# how long identical route requests share one answer, and route requests per visitor per minute
# TOMTOM_BASE_URL=https://api.tomtom.com
# OSRM_BASE_URL=https://router.project-osrm.org
# PLANNER_TIMEOUT_MS=8000
# PLANNER_REFRESH_MS=60000
# PLANNER_ROUTE_CACHE_MS=30000
# PLANNER_ROUTES_PER_MIN=20
# Cloudinary - tests only: a mock upload API and a shorter upload timeout
# CLOUDINARY_API_BASE=https://api.cloudinary.com
# CLOUDINARY_TIMEOUT_MS=15000
